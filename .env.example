# Copy to .env (pnpm setup:env does this). Never commit real values.
NODE_ENV=development

# --- Core ---
DATABASE_URL=postgresql://airwheels:airwheels@localhost:5432/airwheels?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Keys live only in the environment (locally .env, in production the secrets manager). Never in the database.
# 32-byte hex key that encrypts airline signing secrets at rest. `pnpm setup:env` generates one.
APP_ENCRYPTION_KEY=
# Set only while rotating APP_ENCRYPTION_KEY (see README). Leave empty otherwise.
APP_ENCRYPTION_KEY_PREVIOUS=
# 32-byte hex key that derives 4-digit pickup codes. Rotating it changes every live code.
PICKUP_CODE_KEY=
JWT_SECRET=

# --- Mock airline (local only). `pnpm setup:env` generates the secret; the seed and the mock share it. ---
MOCK_AIRLINE_CODE=MOCK
MOCK_AIRLINE_KEY_ID=mock-key-1
MOCK_AIRLINE_SECRET=
MOCK_AIRLINE_PORT=4100

# --- Adapter selection: "fake" (default, no accounts needed) or "live" ---
ADAPTERS_MODE=fake

# --- Payments: Paystack ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- SMS: Termii ---
TERMII_API_KEY=
TERMII_SENDER_ID=

# --- SMS / voice (masked calls): Africa's Talking ---
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_VOICE_NUMBER=

# --- Google Maps Platform ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# --- Flight status backup: AeroDataBox ---
AERODATABOX_API_KEY=
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com

# --- KYC provider (smileid | dojah | youverify) ---
KYC_PROVIDER=
KYC_API_KEY=
KYC_APP_ID=

# --- Email ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Expo push ---
EXPO_ACCESS_TOKEN=

# --- Observability (inactive when empty) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=

# --- Client URLs ---
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
