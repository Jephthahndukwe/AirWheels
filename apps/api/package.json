{
  "name": "@airwheels/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "openapi": "prisma generate && nest build && node dist/openapi.js ../../packages/api-client/openapi.json",
    "prisma:migrate": "dotenv-cli -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv-cli -e ../../.env -- prisma migrate deploy",
    "prisma:seed": "prisma generate && dotenv-cli -e ../../.env -- tsx prisma/seed.ts",
    "prisma:studio": "dotenv-cli -e ../../.env -- prisma studio",
    "secrets:rotate": "prisma generate && dotenv-cli -e ../../.env -- tsx prisma/rotate-secrets.ts"
  },
  "dependencies": {
    "@airwheels/types": "workspace:*",
    "@airwheels/ui": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.10.0",
    "bullmq": "^6.5.3",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.61.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@airwheels/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "dotenv-cli": "^11.1.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15"
  }
}
