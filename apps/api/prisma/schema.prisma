// Airwheels data model (PRD section 18).
// Rules: UUID primary keys, every timestamp is UTC (timestamptz), money is integer kobo (Int/BigInt),
// every table has createdAt/updatedAt. Append-only tables are marked in comments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum BookingChannel {
  ADDON
  WIDGET
  LINK
  OWN_PAGE
  OPS
}

enum Plan {
  STANDARD
  FLEX
}

enum RideType {
  PRIVATE
  SHARED
}

enum LegType {
  DEPARTURE
  ARRIVAL
}

enum VehicleClass {
  SEDAN
  SUV
  VAN
}

enum PowerType {
  ELECTRIC
  HYBRID
  PETROL
}

enum CollectedBy {
  AIRLINE
  AIRWHEELS
}

enum BookingStatus {
  QUOTED
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  PAYMENT_FAILED
  REJECTED
  CANCELLING
  CANCELLED
  REFUNDING
  REFUNDED
}

enum LegStatus {
  SCHEDULED
  ASSIGNED
  DRIVER_CONFIRMED
  EN_ROUTE
  ARRIVED
  PICKED_UP
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SharedGroupStatus {
  OPEN
  LOCKED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  DISSOLVED
}

enum DriverStatus {
  ONBOARDING // created by ops, invite not sent yet
  INVITED
  ACTIVATED
  ACTIVE
  SUSPENDED
}

enum AdminRole {
  OPS_AGENT
  SUPER_ADMIN
  FINANCE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionKind {
  ADMIN
  DRIVER
}

enum ChallengePurpose {
  DRIVER_ACTIVATION
  DRIVER_NEW_DEVICE
}

enum AlertStatus {
  OPEN
  RESOLVED
}

enum AirlineStatus {
  ACTIVE
  PAUSED
  OFFBOARDED
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum FlightSource {
  AIRLINE
  BACKUP_API
  OPS
  DRIVER
  TRAVELLER
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  DEPARTED
  LANDED
  CANCELLED
  DIVERTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
}

enum SettlementStatus {
  DRAFT
  SENT
  PAID
  DISPUTED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum RefundRoute {
  AIRLINE
  PAYSTACK
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

enum EarningType {
  TRIP
  STANDBY
  BONUS
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  APPROVED
  SENT
  FAILED
}

enum PricingRuleType {
  ZONE_FARE
  CEILING
  SURCHARGE
  PLAN
  FEE
  VEHICLE_CLASS
  DISCOUNT
  SHARED_SHARE
  MARGIN_FLOOR
  REVENUE_SHARE
  TAX
  ROUNDING
  COST_MODEL
}

enum BookingStepStatus {
  RUNNING
  DONE
  FAILED
}

enum DispatchPlanStatus {
  PROPOSED
  CONFIRMED
  LOCKED
}

enum OfferResponse {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ActorRole {
  TRAVELLER
  DRIVER
  OPS
  SYSTEM
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
  OPS_CHAT
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum PickupPointType {
  DEPARTURE_DROPOFF
  ARRIVAL_PICKUP
  MEETING_POINT
}

enum Direction {
  TO_AIRPORT
  FROM_AIRPORT
}

// ---------- airlines ----------

model Airline {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  code                 String                @unique // IATA code, e.g. P4
  serviceBrandName     String // e.g. "Air Peace Transfers" (CHN-12)
  status               AirlineStatus         @default(ACTIVE)
  quoteExpiryMinutes   Int                   @default(30)
  revenueShareBps      Int                   @default(0) // basis points of the transfer price the airline keeps
  settlementTerms      Json?
  webhookUrl           String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  credentials          AirlineCredential[]
  themes               AirlineTheme[]
  templates            MessageTemplate[]
  bookings             TransferBooking[]
  settlementStatements SettlementStatement[]
  quotes               Quote[]
}

model AirlineCredential {
  id              String           @id @default(uuid()) @db.Uuid
  airlineId       String           @db.Uuid
  airline         Airline          @relation(fields: [airlineId], references: [id])
  keyId           String           @unique
  /// HMAC verification needs the secret itself, so it is stored AES-256-GCM encrypted with APP_ENCRYPTION_KEY
  /// rather than hashed. See apps/api/src/common/crypto.ts.
  secretEncrypted String
  allowedIps      String[]
  status          CredentialStatus @default(ACTIVE)
  rotatedAt       DateTime?        @db.Timestamptz(3)
  /// Set on the old key when it is rotated: it keeps working until then (grace period).
  expiresAt       DateTime?        @db.Timestamptz(3)
  revokedAt       DateTime?        @db.Timestamptz(3)
  createdById     String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
}

model AirlineTheme {
  id        String   @id @default(uuid()) @db.Uuid
  airlineId String   @db.Uuid
  airline   Airline  @relation(fields: [airlineId], references: [id])
  colours   Json
  font      String?
  logoUrl   String?
  wording   Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model MessageTemplate {
  id           String              @id @default(uuid()) @db.Uuid
  airlineId    String?             @db.Uuid // null = Airwheels own channel
  airline      Airline?            @relation(fields: [airlineId], references: [id])
  event        String
  channel      NotificationChannel
  language     String              @default("en")
  body         String
  buttons      Json?
  providerName String? // approved WhatsApp template name
  version      Int                 @default(1)
  approved     Boolean             @default(false)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([airlineId, event, channel, language, version])
}

// ---------- users, drivers, admins ----------

model User {
  id            String        @id @default(uuid()) @db.Uuid
  phone         String?       @unique
  phoneVerified Boolean       @default(false)
  email         String?       @unique
  passwordHash  String?
  status        UserStatus    @default(ACTIVE)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  driverProfile DriverProfile?
  adminProfile  AdminProfile?
  sessions      Session[]
  loginEvents   LoginEvent[]
}

model DriverProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @db.Uuid
  user               User                @relation(fields: [userId], references: [id])
  firstName          String
  lastName           String
  photoUrl           String?
  status             DriverStatus        @default(ONBOARDING)
  kycProvider        String?
  kycResult          Json?
  kycVerifiedAt      DateTime?           @db.Timestamptz(3)
  ratingAvg          Float?
  ratingCount        Int                 @default(0)
  pinHash            String? // argon2id
  pinFailedCount     Int                 @default(0)
  pinLockedUntil     DateTime?           @db.Timestamptz(3)
  deviceId           String? // the one device allowed to sign in (ACC-06)
  licenceNumber      String?
  idType             String? // NIN | DRIVERS_LICENSE
  idNumber           String?
  address            String?
  referees           Json?
  termsAcceptedAt    DateTime?           @db.Timestamptz(3)
  activatedAt        DateTime?           @db.Timestamptz(3)
  suspendedAt        DateTime?           @db.Timestamptz(3)
  suspendedReason    String?
  onDuty             Boolean             @default(false)
  startLat           Float?
  startLng           Float?
  trainingChecklist  Json?
  bankAccount        Json?
  createdByAdminId   String?             @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  invites            DriverInvite[]
  vehicleAssignments VehicleAssignment[]
  legs               RideLeg[]
  offers             DispatchOffer[]
  earnings           DriverEarning[]
  payouts            Payout[]
  locationPings      LocationPing[]
  sharedGroups       SharedGroup[]
}

model AdminProfile {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  name       String
  role       AdminRole
  totpSecret String? // AES-256-GCM encrypted with APP_ENCRYPTION_KEY
  lastTotpStep Int? // last accepted TOTP time step, so a code cannot be replayed
  failedLoginCount Int @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  invitedById String? @db.Uuid
  lastLoginAt DateTime? @db.Timestamptz(3)
  lastLoginIp String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
}

model DriverInvite {
  id        String        @id @default(uuid()) @db.Uuid
  driverId  String        @db.Uuid
  driver    DriverProfile @relation(fields: [driverId], references: [id])
  phone     String
  codeHash  String // argon2id
  attempts  Int           @default(0)
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  revokedAt DateTime?     @db.Timestamptz(3)
  sentById  String?       @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
}

model CarPartner {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  brand            String
  contact          Json?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  vehicles         Vehicle[]
  usageStatements  UsageStatement[]
}

model Vehicle {
  id          String              @id @default(uuid()) @db.Uuid
  plate       String              @unique
  brand       String
  model       String
  colour      String
  class       VehicleClass
  seats       Int
  bagCapacity Int
  powerType   PowerType
  partnerId   String?             @db.Uuid
  partner     CarPartner?         @relation(fields: [partnerId], references: [id])
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  assignments VehicleAssignment[]
  legs        RideLeg[]
  sharedGroups SharedGroup[]
}

model VehicleAssignment {
  id        String        @id @default(uuid()) @db.Uuid
  vehicleId String        @db.Uuid
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id])
  driverId  String        @db.Uuid
  driver    DriverProfile @relation(fields: [driverId], references: [id])
  from      DateTime      @db.Timestamptz(3)
  to        DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
}

model Document {
  id         String    @id @default(uuid()) @db.Uuid
  ownerType  String // DRIVER | VEHICLE
  ownerId    String    @db.Uuid
  type       String // LICENCE | NIN | INSURANCE | ROADWORTHINESS ...
  storageKey String
  fileName   String?
  contentType String?
  uploadedAt DateTime? @db.Timestamptz(3) // set once the file is confirmed in storage
  uploadedById String? @db.Uuid
  expiresAt  DateTime? @db.Timestamptz(3)
  verifiedBy String?   @db.Uuid
  verifiedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([ownerType, ownerId])
}

// ---------- bookings ----------

model TransferBooking {
  id                      String           @id @default(uuid()) @db.Uuid
  airlineId               String?          @db.Uuid
  airline                 Airline?         @relation(fields: [airlineId], references: [id])
  channel                 BookingChannel
  airlineBookingReference String
  plan                    Plan             @default(STANDARD)
  rideType                RideType         @default(PRIVATE)
  status                  BookingStatus    @default(CONFIRMED)
  policyRuleVersion       Int?
  pricingRuleVersion      Int?
  quoteId                 String?          @unique @db.Uuid
  quote                   Quote?           @relation(fields: [quoteId], references: [id])
  quoteSnapshot           Json?
  collectedBy             CollectedBy
  amountKobo              Int
  airlineShareKobo        Int              @default(0)
  passengers              Int
  bags                    Int
  payTokenHash            String? // our channel: lets the traveller pay and see status without an account
  flaggedForOps           Boolean          @default(false)
  flagReason              String?
  rawPayload              Json? // redacted partner payload, for debugging (8.6)
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(3)
  traveller               Traveller?
  trackingToken           TrackingToken?
  legs                    RideLeg[]
  events                  BookingEvent[]
  policyDecisions         PolicyDecision[]
  refunds                 Refund[]
  paymentIntents          PaymentIntent[]
  ledgerEntries           LedgerEntry[]
  replies                 TravellerReply[]
  steps                   BookingStep[]

  @@unique([airlineId, airlineBookingReference])
  @@index([status])
}

model Traveller {
  id        String          @id @default(uuid()) @db.Uuid
  bookingId String          @unique @db.Uuid
  booking   TransferBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  whatsapp  Boolean         @default(true)
  email     String?
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  @@index([phone])
}

model TrackingToken {
  id        String          @id @default(uuid()) @db.Uuid
  bookingId String          @unique @db.Uuid
  booking   TransferBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tokenHash String          @unique
  /// The link is sent after payment by a queued step, so the token is also kept, encrypted.
  tokenEncrypted String?
  expiresAt DateTime        @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
}

/// One-time code for traveller change and cancel (ACC-02).
model ChangeCode {
  id             String    @id @default(uuid()) @db.Uuid
  bookingId      String    @db.Uuid
  codeHash       String
  attempts       Int       @default(0)
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)
  /// After the right code, a short-lived grant lets the page preview and apply changes.
  grantHash      String?   @unique
  grantExpiresAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([bookingId, createdAt])
}

model RideLeg {
  id                 String          @id @default(uuid()) @db.Uuid
  bookingId          String          @db.Uuid
  booking            TransferBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type               LegType
  rideType           RideType        @default(PRIVATE)
  groupId            String?         @db.Uuid
  group              SharedGroup?    @relation(fields: [groupId], references: [id])
  stopNumber         Int?
  pickupText         String
  pickupLat          Float
  pickupLng          Float
  pickupLandmark     String?
  dropoffText        String
  dropoffLat         Float
  dropoffLng         Float
  dropoffLandmark    String?
  pickupPointId      String?         @db.Uuid
  flightId           String?         @db.Uuid
  flight             FlightRecord?   @relation(fields: [flightId], references: [id])
  scheduledAt        DateTime?       @db.Timestamptz(3)
  nextActionAt       DateTime?       @db.Timestamptz(3) // DSP-05 sweeper
  vehicleClass       VehicleClass    @default(SEDAN)
  status             LegStatus       @default(SCHEDULED)
  driverId           String?         @db.Uuid
  driver             DriverProfile?  @relation(fields: [driverId], references: [id])
  vehicleId          String?         @db.Uuid
  vehicle            Vehicle?        @relation(fields: [vehicleId], references: [id])
  pickupCodeHash     String
  pickupCodeVersion  Int             @default(1) // bump to reissue a code
  pickupCodeFailedAttempts Int       @default(0)
  pickupCodeLockedAt DateTime?       @db.Timestamptz(3)
  amountKobo         Int
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  offers             DispatchOffer[]
  locationPings      LocationPing[]
  callLogs           CallLog[]
  refunds            Refund[]
  earnings           DriverEarning[]
  ratings            Rating[]
  groupStop          GroupStop?
  replies            TravellerReply[]

  @@index([status, nextActionAt])
  @@index([driverId])
}

/// Append-only.
model BookingEvent {
  id        String          @id @default(uuid()) @db.Uuid
  bookingId String          @db.Uuid
  booking   TransferBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String
  actorRole ActorRole
  actorId   String?
  reason    String?
  data      Json?
  time      DateTime        @default(now()) @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  @@index([bookingId, time])
}

/// Idempotency keys for partner and payment calls (BKG-03).
model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String // e.g. airline id
  key          String
  requestHash  String
  responseCode Int
  responseBody Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([scope, key])
}

// ---------- flights ----------

model FlightRecord {
  id           String           @id @default(uuid()) @db.Uuid
  flightNumber String
  date         String // local date YYYY-MM-DD as published by the airline
  airlineCode  String
  origin       String
  destination  String
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  snapshots    FlightSnapshot[]
  legs         RideLeg[]

  @@unique([flightNumber, date])
}

/// Append-only.
model FlightSnapshot {
  id                 String       @id @default(uuid()) @db.Uuid
  flightId           String       @db.Uuid
  flight             FlightRecord @relation(fields: [flightId], references: [id], onDelete: Cascade)
  scheduledDeparture DateTime?    @db.Timestamptz(3)
  scheduledArrival   DateTime?    @db.Timestamptz(3)
  estimatedDeparture DateTime?    @db.Timestamptz(3)
  estimatedArrival   DateTime?    @db.Timestamptz(3)
  actualDeparture    DateTime?    @db.Timestamptz(3)
  actualArrival      DateTime?    @db.Timestamptz(3)
  status             FlightStatus
  terminal           String?
  source             FlightSource
  confidence         Confidence
  rawPayload         Json?
  observedAt         DateTime     @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  @@index([flightId, observedAt])
}

// ---------- pricing and money ----------

/// Immutable once locked.
model Quote {
  id         String           @id @default(uuid()) @db.Uuid
  airlineId  String?          @db.Uuid
  airline    Airline?         @relation(fields: [airlineId], references: [id])
  request    Json
  breakdown  Json
  totalKobo  Int
  marginKobo Int
  flagged    Boolean          @default(false)
  pricingRuleVersion Int
  channel    BookingChannel   @default(WIDGET)
  expiresAt  DateTime         @db.Timestamptz(3)
  lockedAt   DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  booking    TransferBooking?
}

model PaymentIntent {
  id               String          @id @default(uuid()) @db.Uuid
  bookingId        String          @db.Uuid
  booking          TransferBooking @relation(fields: [bookingId], references: [id])
  gateway          String          @default("paystack")
  gatewayReference String          @unique
  amountKobo       Int
  status           PaymentStatus   @default(PENDING)
  idempotencyKey   String          @unique
  authorizationUrl String?
  gatewayFeeKobo   Int?
  paidAt           DateTime?       @db.Timestamptz(3)
  failureReason    String?
  rawPayload       Json? // redacted: never card or payer details
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
}

model SettlementStatement {
  id          String           @id @default(uuid()) @db.Uuid
  airlineId   String           @db.Uuid
  airline     Airline          @relation(fields: [airlineId], references: [id])
  periodStart DateTime         @db.Timestamptz(3)
  periodEnd   DateTime         @db.Timestamptz(3)
  lines       Json
  adjustments Json
  totalKobo   Int
  status      SettlementStatus @default(DRAFT)
  sentAt      DateTime?        @db.Timestamptz(3)
  paidAt      DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([airlineId, periodStart])
}

model LedgerAccount {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique // e.g. airline_receivable:<airlineId>
  name      String
  type      LedgerAccountType
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  entries   LedgerEntry[]
}

/// Double-entry: every transactionId must balance (sum of debits = sum of credits). Append-only.
/// One balanced posting. `reference` is unique, so posting the same event twice is a no-op.
model LedgerTransaction {
  id        String          @id @default(uuid()) @db.Uuid
  reference String          @unique // e.g. payment:<intentId>, refund:<refundId>
  kind      String
  bookingId String?         @db.Uuid
  memo      String?
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  entries   LedgerEntry[]
}

model LedgerEntry {
  id            String           @id @default(uuid()) @db.Uuid
  transactionId String           @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId     String           @db.Uuid
  account       LedgerAccount    @relation(fields: [accountId], references: [id])
  bookingId     String?          @db.Uuid
  booking       TransferBooking? @relation(fields: [bookingId], references: [id])
  amountKobo    BigInt
  direction     LedgerDirection
  reference     String
  memo          String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  @@index([transactionId])
  @@index([accountId])
}

model Refund {
  id         String          @id @default(uuid()) @db.Uuid
  bookingId  String          @db.Uuid
  booking    TransferBooking @relation(fields: [bookingId], references: [id])
  legId      String?         @db.Uuid
  leg        RideLeg?        @relation(fields: [legId], references: [id])
  amountKobo Int
  route      RefundRoute
  status     RefundStatus    @default(REQUESTED)
  reason     String
  issuedById String?         @db.Uuid
  issuedByRole String?
  gatewayRefundId String?    @unique
  completedAt DateTime?      @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
}

model DriverEarning {
  id         String        @id @default(uuid()) @db.Uuid
  driverId   String        @db.Uuid
  driver     DriverProfile @relation(fields: [driverId], references: [id])
  legId      String?       @db.Uuid
  leg        RideLeg?      @relation(fields: [legId], references: [id])
  amountKobo Int
  type       EarningType
  payoutId   String?       @db.Uuid
  payout     Payout?       @relation(fields: [payoutId], references: [id])
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)
}

model Payout {
  id               String          @id @default(uuid()) @db.Uuid
  driverId         String          @db.Uuid
  driver           DriverProfile   @relation(fields: [driverId], references: [id])
  periodStart      DateTime        @db.Timestamptz(3)
  periodEnd        DateTime        @db.Timestamptz(3)
  amountKobo       Int
  status           PayoutStatus    @default(PENDING)
  approvedById     String?         @db.Uuid
  gatewayReference String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  earnings         DriverEarning[]
}

model UsageStatement {
  id          String           @id @default(uuid()) @db.Uuid
  partnerId   String           @db.Uuid
  partner     CarPartner       @relation(fields: [partnerId], references: [id])
  periodStart DateTime         @db.Timestamptz(3)
  periodEnd   DateTime         @db.Timestamptz(3)
  trips       Int
  amountKobo  Int
  status      SettlementStatus @default(DRAFT)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
}

// ---------- rules (versioned, effective-dated) ----------

model PricingRule {
  id            String          @id @default(uuid()) @db.Uuid
  type          PricingRuleType
  key           String // e.g. zone code, surcharge name, plan name
  values        Json
  version       Int
  effectiveFrom DateTime        @db.Timestamptz(3)
  effectiveTo   DateTime?       @db.Timestamptz(3)
  createdById   String?         @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([type, key, effectiveFrom])
}

model PolicyRule {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  conditions    Json
  outcomes      Json
  version       Int
  effectiveFrom DateTime  @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
}

/// Append-only.
model PolicyDecision {
  id          String          @id @default(uuid()) @db.Uuid
  bookingId   String          @db.Uuid
  booking     TransferBooking @relation(fields: [bookingId], references: [id])
  event       String
  inputs      Json
  output      Json
  reasonCode  String
  ruleVersion Int
  overriddenById String?      @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
}

/// Runtime configuration (buffers, cut-offs, timings). Every PRD "assumption" lives here, never in code.
model ConfigEntry {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  value       Json
  version     Int
  description String?
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([key, version])
}

// ---------- dispatch ----------

model DispatchPlan {
  id            String             @id @default(uuid()) @db.Uuid
  date          String // service date YYYY-MM-DD, Africa/Lagos
  legs          Json // proposed [{legId, driverId, standby}]
  status        DispatchPlanStatus @default(PROPOSED)
  confirmedById String?            @db.Uuid
  confirmedAt   DateTime?          @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([date])
}

model DispatchOffer {
  id        String        @id @default(uuid()) @db.Uuid
  legId     String        @db.Uuid
  leg       RideLeg       @relation(fields: [legId], references: [id])
  driverId  String        @db.Uuid
  driver    DriverProfile @relation(fields: [driverId], references: [id])
  sentAt    DateTime      @db.Timestamptz(3)
  expiresAt DateTime      @db.Timestamptz(3)
  response  OfferResponse @default(PENDING)
  respondedAt DateTime?   @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  @@index([legId])
}

/// Trail in Postgres, latest position in Redis.
model LocationPing {
  id        String        @id @default(uuid()) @db.Uuid
  driverId  String        @db.Uuid
  driver    DriverProfile @relation(fields: [driverId], references: [id])
  legId     String?       @db.Uuid
  leg       RideLeg?      @relation(fields: [legId], references: [id])
  lat       Float
  lng       Float
  accuracyM Float?
  time      DateTime      @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  @@index([driverId, time])
}

model CallLog {
  id               String    @id @default(uuid()) @db.Uuid
  legId            String    @db.Uuid
  leg              RideLeg   @relation(fields: [legId], references: [id])
  fromRole         ActorRole
  toRole           ActorRole
  time             DateTime  @db.Timestamptz(3)
  durationSeconds  Int?
  outcome          String
  providerReference String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
}

// ---------- messaging and support ----------

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  recipient         String // phone, email, push token or chat channel
  recipientRole     ActorRole
  bookingId         String?             @db.Uuid
  legId             String?             @db.Uuid
  template          String // event name from PRD 7.1, e.g. booking.confirmed
  templateVersion   Int?
  channel           NotificationChannel
  /// WhatsApp only: TEMPLATE (approved, any time) or SESSION (free-form, inside the 24-hour window).
  kind              String?
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?             @unique
  /// Rendered text with any pickup code masked, so ops can read it without seeing secrets.
  preview           String?
  buttons           Json?
  /// One logical message per booking event; retries and duplicates collapse onto it.
  dedupeKey         String?             @unique
  /// The WhatsApp message this SMS replaced (NTF-01 fallback).
  fallbackForId     String?             @db.Uuid
  sentAt            DateTime?           @db.Timestamptz(3)
  deliveredAt       DateTime?           @db.Timestamptz(3)
  readAt            DateTime?           @db.Timestamptz(3)
  error             String?
  time              DateTime            @default(now()) @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@index([bookingId])
  @@index([recipient, time])
  @@index([channel, status, sentAt])
}

/// WhatsApp customer-service window per phone (PRD 7.3): free-form messages only within 24 hours of the last inbound message.
model ConversationWindow {
  phone         String   @id
  lastInboundAt DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}

model TravellerReply {
  id               String              @id @default(uuid()) @db.Uuid
  bookingId        String              @db.Uuid
  booking          TransferBooking     @relation(fields: [bookingId], references: [id])
  legId            String?             @db.Uuid
  leg              RideLeg?            @relation(fields: [legId], references: [id])
  channel          NotificationChannel
  buttonOrText     String
  mappedIntent     String?
  providerMessageId String?            @unique // idempotency for inbound webhooks (TRV-13)
  time             DateTime            @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
}

model SupportNote {
  id          String   @id @default(uuid()) @db.Uuid
  subjectType String // BOOKING | DRIVER | TRAVELLER_PHONE
  subjectId   String
  authorId    String   @db.Uuid
  text        String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([subjectType, subjectId])
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  legId     String   @db.Uuid
  leg       RideLeg  @relation(fields: [legId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([legId])
}

/// Append-only. Every admin write (PRD 2.2).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?
  actorRole ActorRole
  actorLabel String? // email, phone or airline code at the time
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  time      DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([time])
  @@index([actorId])
}

// ---------- identity (M1) ----------

/// A signed-in admin or driver. The bearer token is a signed JWT whose `sid` points here,
/// so revoking a row (sign out, suspension, new device) ends the session on the next request.
model Session {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  user         User        @relation(fields: [userId], references: [id])
  kind         SessionKind
  deviceId     String?
  ip           String?
  userAgent    String?
  lastSeenAt   DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime    @db.Timestamptz(3)
  revokedAt    DateTime?   @db.Timestamptz(3)
  revokeReason String?
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([userId, revokedAt])
}

/// Login history (ACC-07): every attempt, success or failure. Append-only.
model LoginEvent {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  user       User?       @relation(fields: [userId], references: [id])
  kind       SessionKind
  identifier String // email or phone as typed
  success    Boolean
  reason     String?
  ip         String?
  userAgent  String?
  deviceId   String?
  time       DateTime    @default(now()) @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  @@index([userId, time])
}

/// Staff invite by email (5.4). The first super admin is created by `pnpm admin:create-super`.
model AdminInvite {
  id                String    @id @default(uuid()) @db.Uuid
  email             String
  name              String
  role              AdminRole
  tokenHash         String    @unique
  /// TOTP secret generated when the invitee opens the link, encrypted. Moves to AdminProfile on accept.
  pendingTotpSecret String?
  invitedById       String?   @db.Uuid
  expiresAt         DateTime  @db.Timestamptz(3)
  acceptedAt        DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([email])
}

/// One-time SMS codes for driver activation and new-device sign-in.
model AuthChallenge {
  id        String           @id @default(uuid()) @db.Uuid
  purpose   ChallengePurpose
  phone     String
  userId    String?          @db.Uuid
  codeHash  String // argon2id
  attempts  Int              @default(0)
  data      Json?
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  @@index([phone, purpose])
}

/// Ops alerts (NTF-04): shown on the admin dashboard and pushed over the `ops` WebSocket room.
model OpsAlert {
  id           String      @id @default(uuid()) @db.Uuid
  type         String // PICKUP_CODE_LOCKED | DRIVER_NEW_DEVICE | ...
  status       AlertStatus @default(OPEN)
  message      String
  bookingId    String?     @db.Uuid
  legId        String?     @db.Uuid
  driverId     String?     @db.Uuid
  data         Json?
  resolvedAt   DateTime?   @db.Timestamptz(3)
  resolvedById String?     @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([legId])
}

// ---------- airports, corridors, shared rides ----------

model Airport {
  id           String        @id @default(uuid()) @db.Uuid
  iata         String
  name         String
  terminal     String // e.g. "MMA2", "Domestic GAT"
  lat          Float
  lng          Float
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  pickupPoints PickupPoint[]
  corridors    Corridor[]
  zones        Zone[]

  @@unique([iata, terminal])
}

model PickupPoint {
  id          String          @id @default(uuid()) @db.Uuid
  airportId   String          @db.Uuid
  airport     Airport         @relation(fields: [airportId], references: [id])
  type        PickupPointType
  name        String
  lat         Float
  lng         Float
  directions  String?
  activeHours Json?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
}

/// Pricing zone (area). Fares live in PricingRule(ZONE_FARE, key = zone.code).
model Zone {
  id          String   @id @default(uuid()) @db.Uuid
  airportId   String   @db.Uuid
  airport     Airport  @relation(fields: [airportId], references: [id])
  code        String   @unique
  name        String
  centerLat   Float
  centerLng   Float
  polygon     Json? // GeoJSON polygon; ops draws the real boundary
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  corridorAreas CorridorArea[]
}

model Corridor {
  id         String         @id @default(uuid()) @db.Uuid
  airportId  String         @db.Uuid
  airport    Airport        @relation(fields: [airportId], references: [id])
  name       String
  direction  Direction?     // null = both directions
  sharedOn   Boolean        @default(true)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  areas      CorridorArea[]
  groups     SharedGroup[]

  @@unique([airportId, name])
}

model CorridorArea {
  id         String   @id @default(uuid()) @db.Uuid
  corridorId String   @db.Uuid
  corridor   Corridor @relation(fields: [corridorId], references: [id], onDelete: Cascade)
  zoneId     String   @db.Uuid
  zone       Zone     @relation(fields: [zoneId], references: [id])
  order      Int // 1 = farthest from the airport
  polygon    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([corridorId, order])
}

model SharedGroup {
  id         String            @id @default(uuid()) @db.Uuid
  airportIata String
  terminal   String
  direction  Direction
  date       String
  corridorId String            @db.Uuid
  corridor   Corridor          @relation(fields: [corridorId], references: [id])
  flightNumber String? // arrivals: one flight per group
  status     SharedGroupStatus @default(OPEN)
  route      Json?
  driverId   String?           @db.Uuid
  driver     DriverProfile?    @relation(fields: [driverId], references: [id])
  vehicleId  String?           @db.Uuid
  vehicle    Vehicle?          @relation(fields: [vehicleId], references: [id])
  lockedAt   DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  legs       RideLeg[]
  stops      GroupStop[]
}

model GroupStop {
  id           String      @id @default(uuid()) @db.Uuid
  groupId      String      @db.Uuid
  group        SharedGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  legId        String      @unique @db.Uuid
  leg          RideLeg     @relation(fields: [legId], references: [id])
  order        Int
  plannedTime  DateTime    @db.Timestamptz(3)
  extraMinutes Int
  actualTime   DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
}

model TravelTime {
  id          String   @id @default(uuid()) @db.Uuid
  fromZone    String
  toZone      String
  hourOfDay   Int
  minutes     Int
  refreshedAt DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([fromZone, toZone, hourOfDay])
}

// ---------- booking process and payments (M2) ----------

/// One row per booking step (PRD 8.6): each step runs once, records its result, and is safe to retry.
model BookingStep {
  id          String            @id @default(uuid()) @db.Uuid
  bookingId   String            @db.Uuid
  booking     TransferBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  step        String // confirm_payment | post_ledger | notify_confirmed ...
  status      BookingStepStatus @default(RUNNING)
  attempts    Int               @default(0)
  result      Json?
  error       String?
  completedAt DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([bookingId, step])
}

/// Every payment webhook received, deduplicated by the gateway event identity (PAY-02). Append-only.
model PaymentWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  gateway     String
  eventKey    String    @unique // event + reference + status
  event       String
  reference   String?
  payload     Json // redacted
  processedAt DateTime? @db.Timestamptz(3)
  result      String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([reference])
}

/// Daily Paystack reconciliation (PAY-06).
model ReconciliationRun {
  id            String    @id @default(uuid()) @db.Uuid
  day           String // YYYY-MM-DD, Africa/Lagos
  trigger       String // schedule | ops | system
  checked       Int       @default(0)
  settled       Int       @default(0)
  failed        Int       @default(0)
  mismatches    Json
  finishedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
}
