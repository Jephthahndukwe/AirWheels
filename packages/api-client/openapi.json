        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "legs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "DEPARTURE",
                            "ARRIVAL"
                          ]
                        },
                        "pickup": {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string",
                              "minLength": 3
                            },
                            "location": {
                              "type": "object",
                              "properties": {
                                "lat": {
                                  "type": "number",
                                  "minimum": -90,
                                  "maximum": 90
                                },
                                "lng": {
                                  "type": "number",
                                  "minimum": -180,
                                  "maximum": 180
                                }
                              },
                              "required": [
                                "lat",
                                "lng"
                              ],
                              "additionalProperties": false
                            },
                            "landmark": {
                              "type": "string",
                              "maxLength": 200
                            }
                          },
                          "required": [
                            "text",
                            "location"
                          ],
                          "additionalProperties": false
                        },
                        "dropoff": {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string",
                              "minLength": 3
                            },
                            "location": {
                              "type": "object",
                              "properties": {
                                "lat": {
                                  "type": "number",
                                  "minimum": -90,
                                  "maximum": 90
                                },
                                "lng": {
                                  "type": "number",
                                  "minimum": -180,
                                  "maximum": 180
                                }
                              },
                              "required": [
                                "lat",
                                "lng"
                              ],
                              "additionalProperties": false
                            },
                            "landmark": {
                              "type": "string",
                              "maxLength": 200
                            }
                          },
                          "required": [
                            "text",
                            "location"
                          ],
                          "additionalProperties": false
                        },
                        "flight": {
                          "type": "object",
                          "properties": {
                            "flightNumber": {
                              "type": "string",
                              "pattern": "^[A-Z0-9]{2}\\d{1,4}$"
                            },
                            "date": {
                              "type": "string",
                              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                            },
                            "origin": {
                              "type": "string",
                              "minLength": 3,
                              "maxLength": 3
                            },
                            "destination": {
                              "type": "string",
                              "minLength": 3,
                              "maxLength": 3
                            },
                            "scheduledDeparture": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "scheduledArrival": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "terminal": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "flightNumber",
                            "date",
                            "origin",
                            "destination",
                            "scheduledDeparture",
                            "scheduledArrival"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "type",
                        "pickup",
                        "dropoff",
                        "flight"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 2
                  },
                  "passengers": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  },
                  "bags": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  },
                  "rideType": {
                    "type": "string",
                    "enum": [
                      "PRIVATE",
                      "SHARED"
                    ],
                    "default": "PRIVATE"
                  },
                  "vehicleClass": {
                    "type": "string",
                    "enum": [
                      "SEDAN",
                      "SUV",
                      "VAN"
                    ]
                  },
                  "plan": {
                    "type": "string",
                    "enum": [
                      "STANDARD",
                      "FLEX"
                    ],
                    "default": "STANDARD"
                  }
                },
                "required": [
                  "legs",
                  "passengers",
                  "bags"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "partner"
        ]
      }
    },
